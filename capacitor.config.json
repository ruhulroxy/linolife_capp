{
  "appId": "co.linolife.app",
  "appName": "Lino Life",
  "webDir": "www",
  "server": {
    "url": "https://linolife.co/capp"
  },
  "android": {
    "includePlugins": [
      "@capacitor/barcode-scanner",
      "@capacitor/camera",
      "@capacitor/geolocation",
      "@capacitor/push-notifications",
      "@capacitor/screen-orientation"
    ]
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "banner", "list"]
    }
  }
}
